{
  "manifest_version": 3,
  "name": "Computer Artist",
  "version": "0.5.0",
  "description": "Lets the local ca CLI read and operate tabs it claims, without moving your pointer or switching your tabs.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "watch.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Computer Artist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
